{
  "name": "tosport-dev-tooling",
  "private": true,
  "description": "Development/test-only tooling for ToSport (the site itself is static and has no build step or runtime dependencies).",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:engines": "node tests/run-engines.mjs",
    "test:py": "py -m unittest discover -s tests/py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "leaflet": "^1.9.4"
  }
}
